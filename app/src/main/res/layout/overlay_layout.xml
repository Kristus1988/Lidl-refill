<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="#DD000000"
    android:orientation="vertical"
    android:padding="12dp"
    android:elevation="10dp">

    <!-- ===== TITEL ===== -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lidl Refill"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="6dp"/>

    <!-- ===== STATUS + COUNTDOWN ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● Bereit"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ Warte: --:--"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ===== ZYKLEN + RATE (NEBENEINANDER) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tvCycle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔄 0 Zyklen | ⬇ 0"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/tvRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 0,000 GB/Min"
            android:textColor="#4FC3F7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"/>
    </LinearLayout>

    <!-- ===== OCR ERGEBNIS ===== -->
    <TextView
        android:id="@+id/tvOcrResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📸 OCR: --"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"/>

    <!-- ===== SPINNER ===== -->
    <Spinner
        android:id="@+id/spinnerConsumption"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="#333333"
        android:padding="4dp"
        android:textColor="@android:color/white"
        android:popupBackground="#333333"
        android:layout_marginBottom="4dp"/>

    <!-- ===== BUTTONS ROW 1: SWIPE PLACE + REFILL PLACE + CROP ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnSwipePlace"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="⬇ Swipe"
            android:textSize="11sp"
            android:background="#333333"
            android:textColor="@android:color/white"
            android:layout_marginEnd="3dp"/>

        <Button
            android:id="@+id/btnRefillPlace"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="🔴 Refill"
            android:textSize="11sp"
            android:background="#333333"
            android:textColor="@android:color/white"
            android:layout_marginEnd="3dp"/>

        <Button
            android:id="@+id/btnCrop"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="✂️ Crop"
            android:textSize="11sp"
            android:background="#333333"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- ===== BUTTONS ROW 2: SWIPE TEST + REFILL TEST + OCR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="3dp">

        <Button
            android:id="@+id/btnSwipeTest"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="S Test"
            android:textSize="11sp"
            android:background="#333333"
            android:textColor="@android:color/white"
            android:layout_marginEnd="3dp"/>

        <Button
            android:id="@+id/btnRefillTest"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="R Test"
            android:textSize="11sp"
            android:background="#333333"
            android:textColor="@android:color/white"
            android:layout_marginEnd="3dp"/>

        <Button
            android:id="@+id/btnOcrNow"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="📸 OCR"
            android:textSize="11sp"
            android:background="#333333"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- ===== BUTTONS ROW 3: START + STOP + CLOSE ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="3dp">

        <Button
            android:id="@+id/btnStartAuto"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="▶ Start"
            android:textSize="12sp"
            android:background="#2E7D32"
            android:textColor="@android:color/white"
            android:layout_marginEnd="3dp"/>

        <Button
            android:id="@+id/btnStopAuto"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="⏹ Stop"
            android:textSize="12sp"
            android:background="#B71C1C"
            android:textColor="@android:color/white"
            android:layout_marginEnd="3dp"
            android:enabled="false"/>

        <Button
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="✕"
            android:textSize="14sp"
            android:background="#333333"
            android:textColor="@android:color/white"/>
    </LinearLayout>

</LinearLayout>
